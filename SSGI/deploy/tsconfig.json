{
    "compilerOptions": {
        "experimentalDecorators": true,
        "target": "es2015",
        "module": "commonjs",
        "lib": ["es2015", "dom", "es2020"],
        "rootDir": "./src",
        "sourceMap": true,
        // "alwaysStrict": true,
        // "allowJs": true,
        "moduleResolution": "node",
        // "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noImplicitThis":true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "esModuleInterop": true,
        "baseUrl": "."
    },
    "include": [
        "src/**/*",
        "src/*"
, "src/t.ts"    ],
    "exclude": [
        "node_modules",
        "**/*.spec.ts"
    ]
}